# venvs (nicht Teil des Repos, jeder installiert selbst über requirements.txt)
.venv/
nisqa_server/.venv/
denoise_server/.venv/
separator_server/.venv/

# Laufzeit-/Nutzdaten (nicht versionieren)
data/
snapshots/
settings.json

# Python
__pycache__/
*.pyc

# NISQA/DeepFilterNet-Modell-Caches (werden automatisch nachgeladen)
*.ckpt

# Versehentliche Server-Ausgabedateien (z.B. vor dem output_dir-Fix in 0.20.4
# landeten UVR-Ergebnisse teils im Arbeitsverzeichnis statt in einem Temp-Ordner)
separator_server/*.wav
denoise_server/*.wav
nisqa_server/*.wav
